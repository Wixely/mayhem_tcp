{
  "version": "2.0.0",
  "tasks": [
    {"label": "Build mayhem_tcp", "type": "process", "command": "cargo", "args": ["build", "--locked"], "options": {"cwd": "${workspaceFolder}"}, "problemMatcher": ["$rustc"], "group": {"kind": "build", "isDefault": true}},
    {"label": "Test mayhem_tcp", "type": "process", "command": "cargo", "args": ["test", "--release", "--locked"], "options": {"cwd": "${workspaceFolder}"}, "problemMatcher": ["$rustc"], "group": {"kind": "test", "isDefault": true}},
    {
      "label": "Test mayhem_tcp (live HackRF; stop debug server first)",
      "type": "process",
      "command": "cargo",
      "args": ["test", "--release", "--locked", "--test", "hardware", "--", "--ignored", "--nocapture"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": ["$rustc"],
      "group": "test",
      "presentation": {"reveal": "always", "panel": "dedicated"}
    },
    {"label": "Build USB probe", "type": "process", "command": "cargo", "args": ["build", "--locked", "--manifest-path", "tools/usb-probe/Cargo.toml"], "options": {"cwd": "${workspaceFolder}"}, "problemMatcher": ["$rustc"]}
  ]
}
